    {
      "type": "Feature",
      "properties": {
        "record": "BA-202605481",
        "address": "111 PUTNAM CIR NE, ATLANTA GA 30342",
        "status": "Accepted",
        "date": "10/19/2026",
        "description": null,
        "owner": "LE CROY DARYL G",
        "tree_dbh": "35",
        "tree_location": "Please see site map.",
        "reason_removal": "Uncorrectable defect",
        "tree_description": "None",
        "tree_number": "1",
        "species": "Poplar",
        "comments": "The tree is situated on a sloping grade along the left side of the property, just uphill from the adjacent dwelling. The overall canopy exhibits altered architecture, including abrupt changes in leader direction and reiterative growth, suggesting historic topping or storm-related leader breakage. The lower trunk exhibits abnormal basal taper, characterized by pronounced inward curvature and narrowing on the downhill side, rather than the outward expansion typically associated with a well-developed root flare. Probing conducted with a machete along the uphill side of the trunk base permitted substantial downward penetration without encountering a clearly defined root flare. This condition suggests possible historic grade alteration or the accumulation of fill soil around the root collar. An abundance of loose and sloughing bark was also observed around the basal trunk, with localized indications of possible incipient decay. The surrounding area also exhibits evidence of possible historic trenching near the subject tree and a nearby large tree stump. The apparent trench alignment extends through the immediate area, although vegetation and groundcover limit photographic documentation.",
        "tree_count": 1,
        "trees": [
          {
            "tree_number": "1",
            "species": "Poplar",
            "tree_dbh": "35",
            "tree_location": "Please see site map.",
            "tree_description": "None",
            "reason_removal": "Uncorrectable defect",
            "comments": "The tree is situated on a sloping grade along the left side of the property, just uphill from the adjacent dwelling. The overall canopy exhibits altered architecture, including abrupt changes in leader direction and reiterative growth, suggesting historic topping or storm-related leader breakage. The lower trunk exhibits abnormal basal taper, characterized by pronounced inward curvature and narrowing on the downhill side, rather than the outward expansion typically associated with a well-developed root flare. Probing conducted with a machete along the uphill side of the trunk base permitted substantial downward penetration without encountering a clearly defined root flare. This condition suggests possible historic grade alteration or the accumulation of fill soil around the root collar. An abundance of loose and sloughing bark was also observed around the basal trunk, with localized indications of possible incipient decay. The surrounding area also exhibits evidence of possible historic trenching near the subject tree and a nearby large tree stump. The apparent trench alignment extends through the immediate area, although vegetation and groundcover limit photographic documentation."
          }
        ]
      },
      "geometry": {
